PYTHON_VERSION=

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/micasita_db

# JWT Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (emails)
SENDGRID_API_KEY=
SENDGRID_EMAIL_SENDER=

TOMTOM_API_KEY=

# Tipo de cambio USD → PEN
USD_TO_PEN=3.75

# OSRM propio (opcional). Sin esto, cae al clúster público de demostración
# de OpenStreetMap — el segmento final "/driving" es fijo en los 3, el
# perfil real lo define el grafo con el que se levantó cada instancia.
OSRM_DRIVING_URL=
OSRM_CYCLING_URL=
OSRM_WALKING_URL=

# scripts/seed_db.py — usuario admin y workplace de arranque (opcional).
# Sin esto, se generan valores genéricos y una contraseña al azar en vez de
# credenciales o una dirección real hardcodeadas.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_HOME_LAT=
SEED_ADMIN_HOME_LON=
SEED_ADMIN_HOME_ADDRESS=
SEED_WORKPLACE_ADDRESS=
SEED_WORKPLACE_LAT=
SEED_WORKPLACE_LON=
