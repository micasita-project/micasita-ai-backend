PYTHON_VERSION=

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/micasita_db

# JWT Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary (imágenes)
# Local: IMAGE_STORAGE=local. Producción: IMAGE_STORAGE=cloudinary.
IMAGE_STORAGE=cloudinary
LOCAL_MEDIA_DIR=data/local/uploads
# Opcional: URL accesible desde el emulador, terminada en /media.
LOCAL_MEDIA_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (emails)
SENDGRID_API_KEY=
SENDGRID_EMAIL_SENDER=

TOMTOM_API_KEY=

# Tipo de cambio USD → PEN
USD_TO_PEN=3.75

# OSRM propio (opcional). Sin esto, cae al clúster público de demostración
# de OpenStreetMap — el segmento final "/driving" es fijo en los 3, el
# perfil real lo define el grafo con el que se levantó cada instancia.
OSRM_DRIVING_URL=
OSRM_CYCLING_URL=
OSRM_WALKING_URL=

# scripts/seed_db.py — usuario administrador. Sin SEED_ADMIN_EMAIL no se crea.
# Si SEED_ADMIN_PASSWORD queda vacío, se genera una al azar y se imprime una vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
