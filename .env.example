# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/micasita_db

# JWT Auth
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
